# Production env for the hosted showcase demo. Copy to `.env` on the server and fill in.
#
#   cp .env.production.example .env && chmod 600 .env
#
# Every value below without a default is enforced by docker-compose.prod.yml with `:?`, so the
# stack refuses to start rather than coming up with a development posture on the public
# internet. Generate secrets with:  openssl rand -base64 36
#
# See docs/deploy.md.

# --- host -------------------------------------------------------------------
# Must already resolve to this server: Caddy requests a certificate for it on first boot.
EDGAR_API_DOMAIN=api.example.com

# --- database ---------------------------------------------------------------
POSTGRES_USER=edgar
POSTGRES_PASSWORD=
POSTGRES_DB=edgar

# --- secrets ----------------------------------------------------------------
# >= 32 chars. Rotating it invalidates every issued session token.
EDGAR_BACKEND_JWT_SECRET=
# Bearer token for /metrics and /v1/worker/health. Caddy also 404s those paths, so this is
# defence in depth rather than the only control.
EDGAR_BACKEND_OPS_API_TOKEN=
# One-shot: creates the first admin via POST /v1/auth/bootstrap, then refuses.
EDGAR_BACKEND_BOOTSTRAP_ADMIN_TOKEN=

# Unlocks the adaptive tier (the agentic loop) at registration. This is the code that goes in
# the README and on the CV — it is a filter, not a secret. The per-account ceilings below are
# what actually bound the bill.
EDGAR_BACKEND_ADAPTIVE_INVITE_CODE=

# --- model access -----------------------------------------------------------
EDGAR_BACKEND_LLM_PROVIDER=openai
EDGAR_BACKEND_OPENAI_API_KEY=
EDGAR_BACKEND_AGENT_COMPLETION_MODEL=gpt-5.4-mini
# REQUIRED. Without prices every call estimates at $0.00 and every USD ceiling below becomes a
# silent no-op — the failure mode the spend guard was built to avoid. USD per 1M tokens.
EDGAR_BACKEND_LLM_MODEL_PRICES={"gpt-5.4-mini":{"input_per_1m":0.15,"output_per_1m":0.60},"gpt-5.4-mini-2026-03-17":{"input_per_1m":0.15,"output_per_1m":0.60}}

# --- spend ceilings ---------------------------------------------------------
# Global kill switch for the calendar month. Reaching either stops live runs; the replay tier
# keeps working, so the demo degrades visibly instead of draining a card.
EDGAR_BACKEND_GLOBAL_MONTHLY_MAX_RUNS=300
EDGAR_BACKEND_GLOBAL_MONTHLY_MAX_SPEND_USD=10

# Per account, lifetime. Guests are auto-provisioned and get the tightest budget.
EDGAR_BACKEND_GUEST_MAX_RUNS_PER_ACCOUNT=3
EDGAR_BACKEND_STANDARD_MAX_RUNS_PER_ACCOUNT=25
EDGAR_BACKEND_ADAPTIVE_MAX_RUNS_PER_ACCOUNT=10
EDGAR_BACKEND_ADAPTIVE_MAX_SPEND_USD_PER_ACCOUNT=2

# Per investigation. Tighter than the code defaults because visitors decide how many run.
EDGAR_BACKEND_AGENT_MAX_EXPERIMENTS=8
EDGAR_BACKEND_AGENT_MAX_ELAPSED_SECONDS=180
EDGAR_BACKEND_AGENT_MAX_COST_USD=0.25

# --- retention --------------------------------------------------------------
EDGAR_BACKEND_RETENTION_RUN_PAYLOAD_DAYS=90
EDGAR_BACKEND_RETENTION_MODEL_PAYLOAD_DAYS=30
EDGAR_BACKEND_RETENTION_ARTIFACT_BLOB_DAYS=180
EDGAR_BACKEND_RETENTION_INTERVAL_SECONDS=86400
