# Required for the documented Docker Compose stack — Compose reads `.env` from this
# directory for ${VAR} substitution before starting the backend and worker.
#
#   cp .env.example .env
#
# Then set the required secrets and adjust any optional overrides.

# --- Postgres (`db` service) ---
POSTGRES_USER=edgar
POSTGRES_PASSWORD=edgar
POSTGRES_DB=edgar
# Compose builds EDGAR_BACKEND_DATABASE_URL from these values. Passwords containing
# @ # : / ? must be URL-encoded in the final URL — use simple passwords for local dev,
# or set EDGAR_BACKEND_DATABASE_URL yourself in .env (compose will still substitute
# POSTGRES_* for the db container only).

# --- Backend API + worker (must stay consistent with POSTGRES_* above) ---
# Composed automatically in docker-compose.yml as:
#   postgresql+psycopg2://USER:PASSWORD@db:5432/DB
# Override only if you use a custom URL (e.g. external Postgres):
# EDGAR_BACKEND_DATABASE_URL=postgresql+psycopg2://edgar:edgar@db:5432/edgar
#
# Postgres = documented default for the full stack. Without EDGAR_BACKEND_DATABASE_URL, the API
# defaults to SQLite (data/backend.db) for local convenience and logs database_backend_sqlite.
# In production, use Postgres and optionally:
# EDGAR_BACKEND_ALLOW_SQLITE=false

# Required: random secret, >= 32 chars when EDGAR_BACKEND_DEBUG=false
EDGAR_BACKEND_JWT_SECRET=
EDGAR_BACKEND_OPS_API_TOKEN=
EDGAR_BACKEND_BOOTSTRAP_ADMIN_TOKEN=

EDGAR_BACKEND_DEBUG=false
EDGAR_BACKEND_ALLOW_OPEN_REGISTRATION=false
EDGAR_BACKEND_ALLOW_INSECURE_DEV_JWT=false

# Host port overrides
# API_PORT=8000
# WEB_PORT=3000

# Postgres is not published to the host by default. To inspect from your machine, add to `db`:
#   ports: ["5433:5432"]

# Artifacts default to the local filesystem store: `api` and `worker` share the named
# volume `artifacts` at /var/lib/edgar/artifacts.
#
# Optional remote storage (one S3-compatible backend, still delivered through the app):
# EDGAR_BACKEND_ARTIFACT_STORAGE_BACKEND=s3
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_BUCKET=your-artifact-bucket
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_REGION=us-east-1
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_PREFIX=
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_ENDPOINT_URL=
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_ACCESS_KEY_ID=
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_SECRET_ACCESS_KEY=
# EDGAR_BACKEND_ARTIFACT_STORAGE_S3_FORCE_PATH_STYLE=false
#
# The local compose stack still does not add MinIO or another bundled object store.

# Worker queue (optional; defaults are production-sensible for local compose)
# EDGAR_BACKEND_RUN_JOB_MAX_ATTEMPTS=4
# EDGAR_BACKEND_RUN_JOB_LEASE_SECONDS=900

# --- LLM (OpenAI — intent / planning / critic / report agents) ---
# Queued runs execute in the **worker**; sync execute uses the **api** process — both need the same LLM env.
# After editing, recreate: `docker compose up -d --force-recreate api worker`
#
# EDGAR_BACKEND_LLM_PROVIDER=openai
#
# API key (required when LLM_PROVIDER=openai). Never commit real keys; use `.env` (gitignored).
# EDGAR_BACKEND_OPENAI_API_KEY=sk-...
# Or conventional name (also wired through docker-compose.yml):
# OPENAI_API_KEY=sk-...
#
# Default chat model when a phase-specific override is unset (override if OpenAI renames the id):
# EDGAR_BACKEND_AGENT_COMPLETION_MODEL=gpt-5.4-mini
#
# Optional per-phase overrides (empty = use AGENT_COMPLETION_MODEL):
# EDGAR_BACKEND_AGENT_INTENT_MODEL=
# EDGAR_BACKEND_AGENT_INTENT_PREFERENCES_MODEL=
# EDGAR_BACKEND_AGENT_PLANNING_MODEL=
# EDGAR_BACKEND_AGENT_CRITIC_MODEL=
# EDGAR_BACKEND_AGENT_REPORT_MODEL=
#
# Optional: JSON map of OpenAI-style model id → per-million-token USD rates, for run-level cost estimates
# (``GET /v1/runs/{id}/llm-usage`` and ``transparency.llm_usage`` when include_transparency=true).
# Example: {"gpt-5.4-mini":{"prompt_usd_per_1m":0.15,"completion_usd_per_1m":0.60}}
# EDGAR_BACKEND_AGENT_LLM_PRICING_JSON={}
#
# LLM context budgets (token/size guards for critic/report + summarizers). Defaults are production-sensible;
# see ``backend/agents/context_budget.py`` / ``EDGAR_BACKEND_AGENT_CONTEXT_*`` in settings.
# When trimming applies, critic/report user JSON includes ``llm_context_budget`` booleans (truncation signals).
# Examples (0 = unlimited where documented):
# EDGAR_BACKEND_AGENT_CONTEXT_MAX_ARTIFACT_SUMMARY_ROLES=0
# EDGAR_BACKEND_AGENT_CONTEXT_MAX_FINDINGS_SUMMARY_ROWS=24
# EDGAR_BACKEND_AGENT_CONTEXT_MAX_COVERAGE_ROLES=0
#
# Optional: merge LLM JSON over rule-based GoalPreferences before template selection (default off).
# EDGAR_BACKEND_ORCHESTRATION_LLM_INTENT_ASSISTANCE=false
# EDGAR_BACKEND_AGENT_INTENT_PREFERENCES_PROMPT_VERSION=1.1.0
#
# --- Generalized agentic investigation engine (opt-in, off by default) --------------------------
# When true, a run may execute through the input-agnostic adaptive investigation loop
# (agentic/agent) instead of the deterministic EDGAR pipeline, by setting
# input_payload_json.engine = "agentic". When false (default) every run uses the EDGAR path.
# Enable on BOTH api and worker if you queue runs. With no LLM configured the loop still runs
# deterministically (fixture policy); with LLM_PROVIDER=openai it uses the model-backed policy.
# EDGAR_BACKEND_AGENTIC_ENGINE_ENABLED=false
#
# Optional: Azure / proxy (OpenAI-compatible base URL). Omit for default OpenAI API.
# EDGAR_BACKEND_OPENAI_BASE_URL=
