# Editor (local only; not tracked)
.cursor/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/

# Test / coverage artifacts
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# OS
.DS_Store

# Local env (docker compose / secrets)
.env
# Backups and variants hold the same secrets as .env itself; ``.env`` alone does not
# cover them, so a copy like ``.env.bak.<date>`` would otherwise show up as untracked
# and be one ``git add -A`` away from being committed.
.env.*
# Templates only — these hold placeholders, never values. Each is negated by exact name
# rather than by a pattern like `!.env.*.example`, so a real file that happens to match
# (`.env.production.example.bak`) stays ignored.
!.env.example
!.env.production.example

# Local API database (Alembic / FastAPI dev)
data/backend.db
# WAL/SHM sidecars (SQLite runs in WAL mode; see backend/db/session.py) and local backups
data/backend.db-*
data/backend.db.*

# Managed artifact blobs (local object store)
data/artifact_storage/

# Durable per-run workspaces (EDGAR_BACKEND_RUN_WORKSPACE_ROOT)
data/runs/

# Next.js app (see frontend/.gitignore)
frontend/node_modules/
frontend/.next/

# Root-level node install (tooling); frontend has its own
node_modules/

# Impeccable design-skill state. Critique snapshots are tracked design history
# (they carry the score trend); anything else the skill writes here stays local.
.impeccable/*
!.impeccable/critique/
frontend/.impeccable/*
!frontend/.impeccable/critique/

# Database snapshots from scripts/record_demo.py --dump: every row, including
# password hashes. Never commit these.
var/
*.dump
