      "input": {
        "mode": "orchestration_mocked",
        "tickers": ["AAPL", "MSFT"],
        "goal": "find unusual financial changes",
        "refresh": false,
        "orchestration_scenario": "mock_granular_success"
      },
      "max_runtime_seconds": 30.0,
      "expected_artifacts": {
        "expected_statuses": ["passed"],
        "enforce_schema": false
      },
      "expected_orchestration": {
        "expected_run_status": "success",
