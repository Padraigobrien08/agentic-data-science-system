{
  "uid": "edgar-agent-loop",
  "title": "EDGAR \u00b7 Agentic Investigation Loop",
  "description": "Observability for the adaptive investigation loop: outcomes, why runs stop, per-component decision latency, experiment mix, hypothesis movement, and model spend. Traces for any single run are in Jaeger under the agent.investigation span.",
  "tags": [
    "edgar",
    "agent",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Traces (Jaeger)",
      "type": "link",
      "icon": "external link",
      "url": "http://localhost:16686/search?service=edgar-backend",
      "targetBlank": true,
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Investigations",
      "description": "Investigations reaching a terminal loop status in the selected range. Partial (resumable) calls are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "edgar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "edgar-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(edgar_agent_investigations_total[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "\u2014"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Converged",
      "description": "Share reaching sufficient evidence. Exhausted/failed are the remainder \u2014 insufficient evidence is a valid outcome, not an error.",
      "datasource": {
        "type": "prometheus",
        "uid": "edgar-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "edgar-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(edgar_agent_investigations_total{status=\"converged\"}[$__range])) / clamp_min(sum(increase(edgar_agent_investigations_total[$__range])), 1e-9)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "\u2014"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Median iterations",
      "description": "Median loop iterations per investigation. A flat 1 means the loop is not actually iterating.",
      "datasource": {
        "type": "prometheus",
        "uid": "edgar-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "edgar-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(edgar_agent_investigation_iterations_bucket[$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed"
