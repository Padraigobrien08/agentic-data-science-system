    {
      "id": 11,
      "type": "bargauge",
      "title": "Experiment failure rate by tool",
      "description": "Failures feed the consecutive-failure safety cap, so a persistently failing tool cuts runs short.",
      "datasource": {
        "type": "prometheus",
        "uid": "edgar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "edgar-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (tool_name) (increase(edgar_agent_experiments_total{status=\"failed\"}[$__range])) / clamp_min(sum by (tool_name) (increase(edgar_agent_experiments_total[$__range])), 1e-9)",
