# Backend base URL (server-side only — avoids browser CORS during local dev)
API_URL=http://127.0.0.1:8000

# Docker Compose (frontend service): set in docker-compose.yml to http://api:8000 — do not override locally for compose.

# Optional shortcut on the home page (must be a valid project UUID from your DB)
# NEXT_PUBLIC_DEFAULT_PROJECT_ID=
